void RenderGifOverlay(SpriteInstance* sprite) {
	if (useGDI) {
        HDC hdc = GetDC(sprite->hwnd);

        // Create a compatible DC and bitmap
        HDC hdcMem = CreateCompatibleDC(hdc);
        HBITMAP hbmMem = CreateCompatibleBitmap(hdc, sprite->WIDTH, sprite->HEIGHT);
        SelectObject(hdcMem, hbmMem);

        // Fill with full transparency (black with 0 alpha)
        Gdiplus::Graphics graphics(hdcMem);
        graphics.Clear(Gdiplus::Color(0, 0, 0, 0));

        // Draw the GIF onto the memory DC
        graphics.DrawImage(sprite->gifImage, 0, 0, sprite->WIDTH, sprite->HEIGHT);

        // Copy the transparent buffer to the window
        BitBlt(hdc, 0, 0, sprite->WIDTH, sprite->HEIGHT, hdcMem, 0, 0, SRCCOPY);

        // Cleanup
        DeleteObject(hbmMem);
        DeleteDC(hdcMem);
        ReleaseDC(sprite->hwnd, hdc);

        return;
    }
    glClear(GL_COLOR_BUFFER_BIT);

    glBindTexture(GL_TEXTURE_2D, sprite->textureID);

    glBegin(GL_QUADS);
        glTexCoord2f(0.0f, 0.0f); glVertex2f(-1.0f, -1.0f);
        glTexCoord2f(1.0f, 0.0f); glVertex2f( 1.0f, -1.0f);
        glTexCoord2f(1.0f, 1.0f); glVertex2f( 1.0f,  1.0f);
        glTexCoord2f(0.0f, 1.0f); glVertex2f(-1.0f,  1.0f);
    glEnd();

    SwapBuffers(sprite->hdc);
}


DWORD WINAPI winth(int imgid,int id) {
    
	SpriteInstance* sprite=new SpriteInstance;// = (SpriteInstance*)lpParam;LPVOID lpParam
    sprite->id=id;
    sprite->imageID=imgid;
    cur++;
    sprite->hInstance = GetModuleHandleW(NULL);

    GdiplusStartupInput gdiplusStartupInput;
    GdiplusStartup(&sprite->gdiplusToken, &gdiplusStartupInput, NULL);

    LoadGIFFromResource(sprite);
    sprite->WIDTH = sprite->gifImage->GetWidth();
    sprite->HEIGHT = sprite->gifImage->GetHeight();
    sprite->frameCount = sprite->gifImage->GetFrameCount(&FrameDimensionTime);

    InitOpenGL(sprite, sprite->id * sprite->WIDTH);

    ShowWindow(sprite->hwnd, SW_SHOW);
    UpdateWindow(sprite->hwnd);

    MSG msg;
    while (true) {
        while (PeekMessageW(&msg, NULL, 0, 0, PM_REMOVE)) {
            if (msg.message == WM_QUIT)
                return 0;
            TranslateMessage(&msg);
            DispatchMessageW(&msg);
        }
if(!sprite->pause){

        sprite->currentFrame = (sprite->currentFrame + 1) % sprite->frameCount;

        LoadFrameToTexture(sprite);
        RenderGifOverlay(sprite);

        Sleep(100);}

        if (sprite->id > max) {
            delete sprite;
            ExitThread(0);
        }
    }
}
