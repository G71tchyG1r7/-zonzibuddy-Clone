bool opts = false;
int max = 3;
int cur = 0;
struct SpriteInstance {
HINSTANCE hInstance;
    int id;
    int imageID; // The image to load
    HWND hwnd;
    HDC hdc;
    GLuint textureID;
    Image* gifImage;
    UINT frameCount = 1;
    UINT currentFrame = 0;
    int WIDTH, HEIGHT;

    ULONG_PTR gdiplusToken;
    HDC memDC;
    HBITMAP hBitmap;
    bool dragging = false;
    bool pause=false;
};

    bool useGDI = false;

//    std::mutex mtx; 
    std::shared_mutex imageMutex;
     std::vector<std::thread> threads;
void ShowGLVersion() {
    const char* version = (const char*)glGetString(GL_VERSION);
    if (!version) {
        MessageBoxW(NULL, L"Failed to get GL version!", L"Error", MB_OK | MB_ICONERROR);
        return;
    }

    // Convert char* (ASCII) to wchar_t* (Unicode)
    int len = MultiByteToWideChar(CP_ACP, 0, version, -1, NULL, 0);
    std::wstring wVersion(len, 0);
    MultiByteToWideChar(CP_ACP, 0, version, -1, &wVersion[0], len);

    MessageBoxW(NULL, wVersion.c_str(), L"ver", MB_OK);
}
POINT lastMousePos;

void opmenu(SpriteInstance* sprite){
HMENU hMenu = CreatePopupMenu();
    AppendMenuW(hMenu, MF_STRING, 1, L"Close Sprite");
    AppendMenuW(hMenu, MF_STRING, 2, L"Pause Animation");
    AppendMenuW(hMenu, MF_STRING, 3, L"Options...");
    AppendMenuW(hMenu, MF_STRING, 4, L"GL ver");

    POINT pt;
    GetCursorPos(&pt);
    TrackPopupMenu(hMenu, TPM_RIGHTBUTTON, pt.x, pt.y, 0, sprite->hwnd, NULL);
    DestroyMenu(hMenu);
}
LRESULT CALLBACK WndProc(HWND hwnd, UINT msg, WPARAM wParam, LPARAM lParam) {
	    SpriteInstance* sprite = reinterpret_cast<SpriteInstance*>(GetWindowLongPtr(hwnd, GWLP_USERDATA));

    switch (msg) {
    case WM_LBUTTONDOWN: {
        SetCapture(hwnd);
        sprite->dragging = true;
        GetCursorPos(&lastMousePos); // in screen coords
        return 0;
    }

    case WM_MOUSEMOVE: {
        if (sprite->dragging) {
            POINT curPos;
            GetCursorPos(&curPos); // current screen pos

            int dx = curPos.x - lastMousePos.x;
            int dy = curPos.y - lastMousePos.y;

            RECT rect;
            GetWindowRect(hwnd, &rect);
            MoveWindow(hwnd, rect.left + dx, rect.top + dy, sprite->WIDTH, sprite->HEIGHT, TRUE);

            lastMousePos = curPos; // update last position
        }
        return 0;
    }

    case WM_LBUTTONUP:
        sprite->dragging = false;
        ReleaseCapture();
        return 0;

    case WM_RBUTTONUP:
    opmenu(sprite);  // Pass the sprite instance to the function
    return 0;

case WM_COMMAND:
    switch (LOWORD(wParam)) {
        case 1: // Close Sprite
            PostMessage(sprite->hwnd, WM_CLOSE, 0, 0);  // Close the sprite window
            break;
        case 2: // Pause Animation
            sprite->pause=!sprite->pause;
            break;
        case 3: // opts 
            opts=true;
            break;
            case 4: // GLver 
            ShowGLVersion();
            break;
    }
    return 0;



    case WM_LBUTTONDBLCLK:
    opmenu(sprite);
        return 0;

    case WM_DESTROY:
        PostQuitMessage(0);
        return 0;
    }

    return DefWindowProcW(hwnd, msg, wParam, lParam);
}
INT_PTR CALLBACK OptionsDialogProc(HWND hwndDlg, UINT message, WPARAM wParam, LPARAM lParam) {
    switch (message) {
    case WM_INITDIALOG:
        // Initialize the options dialog here (e.g., load settings)
        return TRUE;

    case WM_COMMAND:
        switch (LOWORD(wParam)) {
        case 106:
            // Handle saving the options if necessary
            EndDialog(hwndDlg, 106);
            return TRUE;

        case 105:
            // Handle canceling the options without saving
            EndDialog(hwndDlg, 105);
            return TRUE;
        }
        break;
    }
    return FALSE;
}
void LoadGIFFromResource(SpriteInstance* sprite) {
    HRSRC hResource = FindResourceW(NULL, MAKEINTRESOURCEW(sprite->imageID), L"GIF");
    if (!hResource) return;

    DWORD imageSize = SizeofResource(NULL, hResource);
    HGLOBAL hGlobal = LoadResource(NULL, hResource);
    if (!hGlobal) return;

    LPVOID pData = LockResource(hGlobal);
    if (!pData) return;

    IStream* pStream = NULL;
    CreateStreamOnHGlobal(NULL, TRUE, &pStream);

    ULONG written;
    pStream->Write(pData, imageSize, &written);
    LARGE_INTEGER liZero = {};
    pStream->Seek(liZero, STREAM_SEEK_SET, NULL);

    sprite->gifImage = Image::FromStream(pStream);
    pStream->Release();
}
