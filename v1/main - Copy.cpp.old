    std::thread tmy(winth,101,1);
	tmy.detach();
	sleep(1);
    std::thread tma(winth,102,2);
	tma.detach();
    std::thread tco(winth,103,3);
	tco.detach();

while(true){
	if (opts) {
        // Create and show the Options dialog window when opts is true
        DialogBox(GetModuleHandle(NULL), MAKEINTRESOURCE(104), NULL, OptionsDialogProc);
        opts = false; // Reset opts to false after the window is opened
    }
	//if(max>cur){
	//maxch(max,cur);
	//}
	/*MSG msg;
    while (GetMessage(&msg, NULL, 0, 0)) {
        TranslateMessage(&msg);
        DispatchMessage(&msg);
