void LoadFrameToTexture(SpriteInstance* sprite) {
    GUID dimension = FrameDimensionTime;
    sprite->gifImage->SelectActiveFrame(&dimension, sprite->currentFrame);

    // Clone the current frame from the GIF
    Bitmap* frame = static_cast<Bitmap*>(sprite->gifImage->Clone());

    // Create HBITMAP
    frame->GetHBITMAP(Color(0, 0, 0), &sprite->hBitmap);
    sprite->memDC = CreateCompatibleDC(sprite->hdc);
    SelectObject(sprite->memDC, sprite->hBitmap);

    // Set up OpenGL texture
    glBindTexture(GL_TEXTURE_2D, sprite->textureID);
    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);

    BitmapData bmpData;
    Rect rect(0, 0, sprite->WIDTH, sprite->HEIGHT);

    // Lock the frame to access pixel data
    frame->LockBits(
        &rect,
        ImageLockModeRead,
        PixelFormat32bppARGB,
        &bmpData // store here!
    );

    BYTE* pixels = new BYTE[sprite->WIDTH * sprite->HEIGHT * 4];
    UINT* src = (UINT*)bmpData.Scan0;

    // Copy and flip pixels vertically
    for (int y = 0; y < sprite->HEIGHT; y++) {
        int srcIndex = y * sprite->WIDTH;
        int destIndex = (sprite->HEIGHT - 1 - y) * sprite->WIDTH;
        
        // Copy one row at a time, flipping vertically
        for (int x = 0; x < sprite->WIDTH; x++) {
            // Extract ARGB components
            BYTE r = (src[srcIndex + x] >> 16) & 0xFF;
            BYTE g = (src[srcIndex + x] >> 8)  & 0xFF;
            BYTE b = (src[srcIndex + x] >> 0)  & 0xFF;
            BYTE a = (src[srcIndex + x] >> 24) & 0xFF;

            // Set the flipped pixel
            pixels[(destIndex + x) * 4 + 0] = r;
            pixels[(destIndex + x) * 4 + 1] = g;
            pixels[(destIndex + x) * 4 + 2] = b;
            pixels[(destIndex + x) * 4 + 3] = a;
        }
    }

    // Now upload the flipped pixel data to OpenGL
    glTexImage2D(
        GL_TEXTURE_2D,
        0,
        GL_RGBA,
        sprite->WIDTH,
        sprite->HEIGHT,
        0,
        GL_RGBA, // Use BGRA format for OpenGL
        GL_UNSIGNED_BYTE,
        pixels
    );

    // Clean up
    delete[] pixels;
    frame->UnlockBits(&bmpData); // Unlock bitmap data
    delete frame; // Clean up bitmap
}


